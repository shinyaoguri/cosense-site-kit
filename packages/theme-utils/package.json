{
  "name": "@cosense-site-kit/theme-utils",
  "version": "0.4.8",
  "description": "Shared runtime helpers for cosense-site-kit themes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinyaoguri/cosense-site-kit.git",
    "directory": "packages/theme-utils"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./components/*": "./src/components/*"
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "astro check && tsc --noEmit"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@cosense-site-kit/core": "^0.4.2",
    "katex": "^0.17.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.1.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
