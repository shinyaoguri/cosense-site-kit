{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "preserve",
    "types": ["astro/client"]
  },
  // Type-check tests too — they were previously excluded, which hid real type
  // errors (e.g. a required option missing in a test fixture). rootDir is left
  // unset so test/** can be included; tsup infers its own output layout from the
  // src entry, and typecheck runs with --noEmit.
  // src/**/*.astro is listed for `astro check` — without it the language server
  // treats .astro files as out-of-project and silently skips them. tsc ignores
  // the pattern (unsupported extension), so --noEmit is unaffected.
  // .astro/types.d.ts is generated by `astro sync` (run by `astro check`) from
  // src/content.config.ts; it provides the real `astro:content` types. When it
  // doesn't exist yet, Astro's loose fallback types apply instead.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.astro",
    "test/**/*.ts",
    ".astro/types.d.ts"
  ]
}
