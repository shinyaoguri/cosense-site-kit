---
// Click- or keyboard-to-zoom lightbox for content images. Activating a
// (non-inline, non-linked) image inside .page-content opens a full-screen
// overlay with the image at full size; a visible close button, a click anywhere,
// or Escape closes it. Progressive enhancement: with no JS the images render
// normally and this does nothing. Styles live in global.css (.lightbox).
---

<script>
  import { trapFocus } from "../scripts/focus-trap";

  // Block content images only — skip tiny inline icons (.inline-image) and
  // images the author wrapped in a link (let the link navigate instead).
  const SELECTOR = ".page-content img:not(.inline-image)";
  let overlay: HTMLElement | null = null;
  let lastFocused: HTMLElement | null = null;
  let releaseTrap: (() => void) | null = null;

  // Make each eligible image operable by keyboard (WCAG 2.1.1): focusable and
  // announced as a button. The click/keydown handlers below are delegated, so
  // this only needs to set attributes. Runs per full page load (the theme uses
  // native cross-document view transitions, so scripts re-run on navigation).
  const markImages = () => {
    document.querySelectorAll<HTMLImageElement>(SELECTOR).forEach((img) => {
      if (img.closest("a") || img.dataset.lightbox) return;
      img.dataset.lightbox = "1";
      img.setAttribute("tabindex", "0");
      img.setAttribute("role", "button");
      const alt = img.getAttribute("alt");
      img.setAttribute("aria-label", alt ? `Zoom image: ${alt}` : "Zoom image");
    });
  };

  const build = (): HTMLElement => {
    if (overlay) return overlay;
    overlay = document.createElement("div");
    overlay.className = "lightbox";
    overlay.setAttribute("role", "dialog");
    overlay.setAttribute("aria-modal", "true");
    overlay.setAttribute("aria-label", "Image viewer");
    overlay.hidden = true;

    const img = document.createElement("img");
    img.className = "lightbox__img";
    img.alt = "";

    const closeBtn = document.createElement("button");
    closeBtn.type = "button";
    closeBtn.className = "lightbox__close";
    closeBtn.setAttribute("aria-label", "Close image viewer");
    closeBtn.innerHTML =
      '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
    closeBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      close();
    });

    overlay.appendChild(img);
    overlay.appendChild(closeBtn);
    overlay.addEventListener("click", close);
    document.body.appendChild(overlay);
    return overlay;
  };

  const open = (src: string, alt: string) => {
    const el = build();
    const img = el.querySelector<HTMLImageElement>(".lightbox__img");
    if (img) {
      img.src = src;
      img.alt = alt || "";
    }
    lastFocused = document.activeElement as HTMLElement | null;
    el.hidden = false;
    // Force a reflow so the .is-open transition runs from the hidden state.
    void el.offsetWidth;
    el.classList.add("is-open");
    document.documentElement.classList.add("lightbox-open");
    // Move focus into the dialog (to the visible close button) and trap it there
    // so the dialog isn't "open with focus still outside" for SR/keyboard users.
    el.querySelector<HTMLButtonElement>(".lightbox__close")?.focus();
    releaseTrap = trapFocus(el);
  };

  function close() {
    if (!overlay || overlay.hidden) return;
    releaseTrap?.();
    releaseTrap = null;
    overlay.classList.remove("is-open");
    document.documentElement.classList.remove("lightbox-open");
    let done = false;
    const finish = () => {
      if (done || !overlay) return;
      done = true;
      overlay.hidden = true;
      overlay.removeEventListener("transitionend", finish);
    };
    overlay.addEventListener("transitionend", finish);
    window.setTimeout(finish, 300); // fallback if no transition fires
    if (lastFocused?.focus) lastFocused.focus();
  }

  markImages();

  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement | null;
    const img = t?.closest?.(SELECTOR) as HTMLImageElement | null;
    if (!img || img.closest("a")) return;
    e.preventDefault();
    open(img.currentSrc || img.src, img.alt);
  });

  document.addEventListener("keydown", (e) => {
    // Ignore keys fired during IME composition (e.g. Esc to cancel a conversion).
    if (e.isComposing || e.keyCode === 229) return;
    if (e.key === "Escape") {
      close();
      return;
    }
    // Enter/Space activates a focused content image (it's role="button").
    if (e.key === "Enter" || e.key === " ") {
      const t = e.target as HTMLElement | null;
      const img = t?.closest?.(SELECTOR) as HTMLImageElement | null;
      if (img && !img.closest("a")) {
        e.preventDefault();
        open(img.currentSrc || img.src, img.alt);
      }
    }
  });
</script>
