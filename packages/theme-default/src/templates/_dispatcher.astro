---
import type { CollectionEntry } from "astro:content";
import { pagePaths } from "@cosense-site-kit/theme-utils";
import Collection from "./collection.astro";
import Page from "./page.astro";
import Profile from "./profile.astro";

// Theme's per-page template registry. Add a new template by importing the
// .astro file at the top and adding an entry below — the page-level
// `#template/<name>` tag and `.site` YAML `templates:` mapping look these up.
// Unknown names fall back to Page so a bad tag never 500s.
const TEMPLATES: Record<string, typeof Page> = {
  page: Page,
  profile: Profile,
  collection: Collection,
};

export async function getStaticPaths() {
  return pagePaths();
}

const { entry } = Astro.props as { entry: CollectionEntry<"pages"> };
// Object.hasOwn (not `?? Page`): `??` only catches undefined/null, so an
// inherited key like `#template/constructor` would resolve to Object.prototype's
// property instead of falling back — rendering a non-component and crashing the
// whole `astro build`. Guarding on own keys keeps the "bad tag never 500s"
// contract that the registry comment above promises.
// The inner `?? Page` never fires at runtime (hasOwn guarantees the key);
// it only narrows away the `undefined` that noUncheckedIndexedAccess adds.
const Template = Object.hasOwn(TEMPLATES, entry.data.template)
  ? (TEMPLATES[entry.data.template] ?? Page)
  : Page;
---
<Template entry={entry} />
